# Optional overrides for the ADK trading agent.
# Copy this file to .env and fill in your values.

# --- Exemplar Cost Observability ---
# Where the SDK ships observed data (your running integration-service).
# EXEMPLAR_BASE_URL=http://localhost:8000

# API key for the integration-service. Paste your eis_ key here.
# EXEMPLAR_API_KEY=

# --- Gemini ---
GEMINI_API_KEY=

# --- Voyage AI RAG ---
# Your Voyage API key (required for RAG embedding + retrieval)
VOYAGE_API_KEY=

# Embedding model (default: voyage-3)
# VOYAGE_EMBED_MODEL=voyage-3

# ChromaDB collection name (default: trading_knowledge)
# RAG_COLLECTION=trading_knowledge
